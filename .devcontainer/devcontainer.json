{
	"name": "esp-lowcode-matter-v0.6",
	"image": "mcr.microsoft.com/devcontainers/cpp:debian-12",
	"customizations": {
		"vscode": {
			"extensions": [
				"espressif.esp-lowcode",
				"-ms-vscode.cmake-tools",
				"-twxs.cmake"
			],
			"settings": {
				"extensions.ignoreRecommendations": true,
				"files.exclude": {
					"esp-idf": false,
					"esp-amp": false,
					"**/.vscode": true
				},
				"C_Cpp.default.includePath": [
					"${workspaceFolder}/**",
					"/workspace/esp-lowcode-matter/**",
					"/workspace/esp-idf/**",
					"/workspace/esp-amp/**"
				],
				"git.detectSubmodulesLimit": 25,
				"editor.wordWrapColumn": 120,
				"editor.scrollBeyondLastLine": false,
                "terminal.integrated.scrollback": 20000,
                "workbench.startupEditor": "none",
                "editor.snippetSuggestions": "inline"
            },
            "mcp": {
                "servers": {
                    "idf-builder": {
                      "command": "/workspace/esp-lowcode-matter/mcp_tools/examples/idf-builder/venv/bin/python3",
                      "args": [
                        "/workspace/esp-lowcode-matter/mcp_tools/examples/idf-builder/server.py"
                      ],
                      "env": {
                        "PATH": "/workspace/esp-lowcode-matter/mcp_tools/examples/idf-builder/venv/bin:/workspace/esp-idf/tools:/workspace/esp-idf/components/espcoredump:/workspace/esp-idf/components/partition_table:/workspace/esp-idf/components/app_update:/workspace/esp-idf/components/espcoredump:/workspace/esp-idf/components/partition_table:/workspace/esp-idf/components/app_update:/root/.espressif/tools/riscv32-esp-elf-gdb/16.3_20250913/riscv32-esp-elf-gdb/bin:/root/.espressif/tools/riscv32-esp-elf/esp-13.2.0_20250707/riscv32-esp-elf/bin:/root/.espressif/tools/openocd-esp32/v0.12.0-esp32-20250707/openocd-esp32/bin:/root/.espressif/python_env/idf5.3_py3.11_env/bin:/workspace/esp-idf/tools:/root/.espressif/tools/riscv32-esp-elf/esp-13.2.0_20250707/riscv32-esp-elf/bin:/root/.espressif/tools/riscv32-esp-elf-gdb/16.3_20250913/riscv32-esp-elf-gdb/bin:/workspace/esp-idf/tools:/root/.espressif/python_env/idf5.3_py3.11_env/bin:/vscode/bin/linux-x64/cb1933bbc38d329b3595673a600fab5c7368f0a7/bin/remote-cli:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/local/vcpkg:/root/.local/bin",
                        "IDF_PATH": "/workspace/esp-idf",
                        "IDF_PYTHON_ENV_PATH": ""
                      }
                    },
                    "device-test": {
                      "command": "/workspace/esp-lowcode-matter/mcp_tools/examples/device-test/venv/bin/python3",
                      "args": [
                        "/workspace/esp-lowcode-matter/mcp_tools/examples/device-test/server.py"
                      ],
                      "env": {
                        "PATH": "/workspace/esp-lowcode-matter/mcp_tools/examples/device-test/venv/bin:/workspace/esp-idf/tools:/workspace/esp-idf/components/espcoredump:/workspace/esp-idf/components/partition_table:/workspace/esp-idf/components/app_update:/workspace/esp-idf/components/espcoredump:/workspace/esp-idf/components/partition_table:/workspace/esp-idf/components/app_update:/root/.espressif/tools/riscv32-esp-elf-gdb/16.3_20250913/riscv32-esp-elf-gdb/bin:/root/.espressif/tools/riscv32-esp-elf/esp-13.2.0_20250707/riscv32-esp-elf/bin:/root/.espressif/tools/openocd-esp32/v0.12.0-esp32-20250707/openocd-esp32/bin:/root/.espressif/python_env/idf5.3_py3.11_env/bin:/workspace/esp-idf/tools:/root/.espressif/tools/riscv32-esp-elf/esp-13.2.0_20250707/riscv32-esp-elf/bin:/root/.espressif/tools/riscv32-esp-elf-gdb/16.3_20250913/riscv32-esp-elf-gdb/bin:/workspace/esp-idf/tools:/root/.espressif/python_env/idf5.3_py3.11_env/bin:/vscode/bin/linux-x64/cb1933bbc38d329b3595673a600fab5c7368f0a7/bin/remote-cli:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/local/vcpkg:/root/.local/bin",
                        "IDF_PATH": "/workspace/esp-idf",
                        "IDF_PYTHON_ENV_PATH": ""
                      }
                    },
                    "system": {
                      "command": "/workspace/esp-lowcode-matter/mcp_tools/examples/system/venv/bin/python3",
                      "args": [
                        "/workspace/esp-lowcode-matter/mcp_tools/examples/system/server.py"
                      ],
                      "env": {
                        "PATH": "/workspace/esp-lowcode-matter/mcp_tools/examples/system/venv/bin:/workspace/esp-idf/tools:/workspace/esp-idf/components/espcoredump:/workspace/esp-idf/components/partition_table:/workspace/esp-idf/components/app_update:/workspace/esp-idf/components/espcoredump:/workspace/esp-idf/components/partition_table:/workspace/esp-idf/components/app_update:/root/.espressif/tools/riscv32-esp-elf-gdb/16.3_20250913/riscv32-esp-elf-gdb/bin:/root/.espressif/tools/riscv32-esp-elf/esp-13.2.0_20250707/riscv32-esp-elf/bin:/root/.espressif/tools/openocd-esp32/v0.12.0-esp32-20250707/openocd-esp32/bin:/root/.espressif/python_env/idf5.3_py3.11_env/bin:/workspace/esp-idf/tools:/root/.espressif/tools/riscv32-esp-elf/esp-13.2.0_20250707/riscv32-esp-elf/bin:/root/.espressif/tools/riscv32-esp-elf-gdb/16.3_20250913/riscv32-esp-elf-gdb/bin:/workspace/esp-idf/tools:/root/.espressif/python_env/idf5.3_py3.11_env/bin:/vscode/bin/linux-x64/cb1933bbc38d329b3595673a600fab5c7368f0a7/bin/remote-cli:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/local/vcpkg:/root/.local/bin",
                        "IDF_PATH": "/workspace/esp-idf",
                        "IDF_PYTHON_ENV_PATH": ""
                      }
                   }
                }
            }
        }
    },
    "workspaceFolder": "/workspace/esp-lowcode-matter",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/esp-lowcode-matter,type=bind",
    "remoteUser": "root",

    "onCreateCommand": "apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y git wget flex bison gperf python3 python3-pip python3-venv cmake ninja-build ccache libffi-dev libssl-dev dfu-util libusb-1.0-0 libcairo2-dev && mkdir -p /workspace && cd /workspace && git clone --depth 1 https://github.com/espressif/esp-idf.git -b release/v5.3 && cd /workspace/esp-idf && git submodule update --init && ./install.sh esp32c6 && . ./export.sh && cd /workspace && git clone --depth 1 https://github.com/espressif/esp-amp.git -b main && cd /workspace/esp-amp && export ESP_AMP_PATH=/workspace/esp-amp && cd /workspace/esp-lowcode-matter && export LOW_CODE_PATH=/workspace/esp-lowcode-matter && ./install.sh && . ./export.sh && echo '. /workspace/esp-idf/export.sh' >> ~/.bashrc && echo '. /workspace/esp-lowcode-matter/export.sh' >> ~/.bashrc && cd /workspace/esp-lowcode-matter/products && for dir in */; do if [ \"$dir\" != \"common/\" ]; then cd \"$dir\" && idf.py set-target esp32c6 && idf.py build && cd ..; fi; done && cd /workspace/esp-lowcode-matter",

    "containerEnv": {
        "IDF_PATH": "/workspace/esp-idf",
        "ESP_AMP_PATH": "/workspace/esp-amp",
        "LOW_CODE_PATH": "/workspace/esp-lowcode-matter",
        "ESP_MATTER_PATH": "/workspace/esp-lowcode-matter/tools/dependencies/esp-matter",
        "ZAP_INSTALL_PATH": "/workspace/esp-lowcode-matter/tools/dependencies/esp-matter/connectedhomeip/connectedhomeip/.environment/cipd/packages/zap",
        "ESP_RMAKER_PATH": "/workspace/esp-lowcode-matter/tools/dependencies/esp-rainmaker",
        "ESP_SECURE_CERT_PATH": "/workspace/esp-lowcode-matter/tools/dependencies/esp_secure_cert_mgr",
        "MATTER_ONE_PATH": "/workspace/esp-lowcode-matter/tools/dependencies/matter-one"
    },
    "remoteEnv": {
        "IDF_PATH": "/workspace/esp-idf",
        "ESP_AMP_PATH": "/workspace/esp-amp",
        "LOW_CODE_PATH": "/workspace/esp-lowcode-matter",
        "ESP_MATTER_PATH": "/workspace/esp-lowcode-matter/tools/dependencies/esp-matter",
        "ZAP_INSTALL_PATH": "/workspace/esp-lowcode-matter/tools/dependencies/esp-matter/connectedhomeip/connectedhomeip/.environment/cipd/packages/zap",
        "ESP_RMAKER_PATH": "/workspace/esp-lowcode-matter/tools/dependencies/esp-rainmaker",
        "ESP_SECURE_CERT_PATH": "/workspace/esp-lowcode-matter/tools/dependencies/esp_secure_cert_mgr",
        "MATTER_ONE_PATH": "/workspace/esp-lowcode-matter/tools/dependencies/matter-one"
    }
}
